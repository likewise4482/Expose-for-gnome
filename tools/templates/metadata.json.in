{
  "uuid": "@EXTENSION_UUID@",
  "name": "@PRODUCT_NAME@",
  "description": "Spreads out the windows of the focused application so you can pick one: only that app's windows, from all workspaces, with minimized windows shown as cards. Toggle it with a keyboard shortcut (default Ctrl+Super+Down) or over D-Bus.\n\nOptional companion app (mouse/keyboard button mapper, CLI): @HOMEPAGE@",
  "shell-version": [@SHELL_VERSIONS@],
  "settings-schema": "@SCHEMA_ID@",
  "url": "@HOMEPAGE@",
  "version-name": "@VERSION@"
}
