# Single source of truth for names, IDs and URLs.
# After editing, run `make sync-ids` (tools/sync_ids.py) and commit the result;
# `make test` fails if any generated file is out of date.

PRODUCT_NAME="Expose for GNOME"
VERSION="1.0.0"
HOMEPAGE="https://github.com/likewise4482/Expose-for-gnome"

# GNOME Shell extension
SHELL_VERSIONS="45 46 47 48 49 50 51"
EXTENSION_UUID="expose-for-gnome@likewise4482.github.io"
SCHEMA_ID="org.gnome.shell.extensions.expose-for-gnome"
SCHEMA_PATH="/org/gnome/shell/extensions/expose-for-gnome/"
SHELL_BUS_NAME="io.github.likewise4482.ExposeForGnome.Shell"
SHELL_OBJECT_PATH="/io/github/likewise4482/ExposeForGnome/Shell"

# Companion app (GUI + button mapper daemon)
APP_ID="io.github.likewise4482.ExposeForGnome"
DAEMON_BUS_NAME="io.github.likewise4482.ExposeForGnome.Daemon"
DAEMON_OBJECT_PATH="/io/github/likewise4482/ExposeForGnome/Daemon"
SLUG="expose-for-gnome"
SYSTEMD_UNIT="expose-for-gnome.service"
UDEV_PREFIX="70-expose-for-gnome"
